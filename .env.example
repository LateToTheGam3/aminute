# Copy to .env and fill in. Never commit the real .env.
# Free key from https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=your-key-here

# Must be a model your account has free quota for. Older Gemini models
# return "quota: 0" on new accounts.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: hard ceiling on AI calls per day (default 600).
# AI_DAILY_MAX=600
